.menu-root {
    align-items: center;
    justify-content: center;
}

.menu-backdrop {
    background-color: var(--fb-backdrop);
}

.menu--hidden {
    display: none;
}

.menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 160px;
    padding-right: 140px;
}

.menu-left {
    width: 820px;
    align-items: flex-start;
}

.menu-title {
    font-size: 168px;
    color: var(--fb-warn);
    letter-spacing: -2px;
    text-shadow: 8px 8px 0 rgb(28, 22, 26);
    transform-origin: left;
    rotate: -2deg;
    white-space: normal;
}

.menu-tagline {
    margin-top: 32px;
    font-size: var(--fb-font-l);
}

.menu-play {
    margin-top: 56px;
    padding: 22px 64px;
    border-radius: 16px;
    border-bottom-width: 8px;
    border-bottom-color: rgb(150, 95, 10);
    font-size: 38px;
}

.menu-play:hover {
    border-bottom-color: rgb(150, 95, 10);
}

.menu-hint-row {
    flex-direction: row;
    align-items: center;
    margin-top: 28px;
}

.menu-hint__key {
    margin-right: 12px;
}

.menu-hint {
    font-size: var(--fb-font-s);
}

.menu-card {
    width: 740px;
    padding: 32px 36px;
    border-radius: 20px;
    background-color: var(--fb-chip-solid);
    border-width: 2px;
    border-color: var(--fb-chip-border);
    rotate: 1deg;
}

.menu-card__heading-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

.menu-card__heading {
    font-size: var(--fb-font-m);
    color: var(--fb-warn);
}

.menu-card__rule {
    flex-grow: 1;
    height: 2px;
    margin-left: 14px;
    background-color: var(--fb-chip-border);
}

.menu-modes {
    flex-direction: row;
    margin: 0 -5px;
}

.menu-mode {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 5px;
    padding: 16px 14px 14px 14px;
    align-items: flex-start;
}

.menu-mode.fb-button--selected {
    rotate: -2deg;
}

.menu-mode__bars {
    flex-direction: row;
    align-items: flex-end;
    height: 28px;
}

.menu-mode__bar {
    width: 10px;
    margin-right: 4px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.15);
}

.menu-mode__bar--1 { height: 10px; }
.menu-mode__bar--2 { height: 18px; }
.menu-mode__bar--3 { height: 26px; }

.menu-mode__bar--lit {
    background-color: var(--fb-warn);
}

.fb-button--selected .menu-mode__bar {
    background-color: rgba(28, 22, 26, 0.25);
}

.fb-button--selected .menu-mode__bar--lit {
    background-color: var(--fb-ink);
}

.menu-mode__interval {
    margin-top: 12px;
    padding: 0;
    font-size: 40px;
    -unity-text-align: middle-left;
}

.menu-mode__name {
    margin-top: 6px;
    padding: 0;
    font-size: var(--fb-font-s);
    -unity-text-align: middle-left;
}

.menu-mode-caption {
    margin: 14px 4px 24px 4px;
    min-height: 44px;
    font-size: var(--fb-font-s);
    white-space: normal;
}

.menu-volume {
    flex-direction: row;
    align-items: center;
    margin: 8px 0;
}

.menu-volume__label {
    width: 250px;
    font-size: var(--fb-font-s);
    white-space: normal;
}

.menu-volume__slider {
    flex-grow: 1;
    margin: 0 14px;
}

.menu-volume__slider .unity-base-slider__tracker {
    height: 8px;
    margin-top: -4px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.15);
    overflow: hidden;
}

.menu-volume__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 4px;
    background-color: var(--fb-warn);
}

.menu-volume__slider .unity-base-slider__dragger {
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-width: 3px;
    border-radius: 11px;
    border-color: var(--fb-text);
    background-color: var(--fb-warn);
}

.menu-volume__value {
    width: 64px;
    -unity-text-align: middle-right;
    font-size: var(--fb-font-m);
}

.menu-company {
    position: absolute;
    left: 18px;
    top: 14px;
    font-size: var(--fb-font-s);
}

.briefing {
    align-items: center;
    justify-content: center;
}

.briefing__card {
    width: 640px;
    padding: 26px 32px;
    border-radius: 22px;
    border-width: 3px;
    border-color: var(--fb-warn);
    background-color: var(--fb-chip-solid);
}

.briefing__counter {
    font-size: var(--fb-font-s);
    color: var(--fb-warn);
}

.briefing__title {
    margin: 4px 0 10px 0;
    font-size: 36px;
    white-space: normal;
}

.briefing__body {
    min-height: 110px;
    font-size: var(--fb-font-m);
    white-space: normal;
}

.briefing__dots {
    flex-direction: row;
    justify-content: center;
    margin: 18px 0;
}

.briefing__dot {
    width: 12px;
    height: 12px;
    margin: 0 5px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.2);
}

.briefing__dot--current {
    background-color: var(--fb-warn);
}

.briefing__buttons {
    flex-direction: row;
    justify-content: space-between;
}

.briefing__nav {
    flex-direction: row;
}

.briefing__back {
    margin-right: 10px;
}
